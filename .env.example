# Supabase project settings — Project Settings → API in the Supabase dashboard
# for the "Business Use Case Tool" project (EU / Frankfurt region).

# Public — safe to expose to the browser, used by the client-side Supabase client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret — server-only. Used solely by scripts/seed.ts to seed the initial
# MARKT-PILOT template and (optionally) to create the single admin user.
# Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
